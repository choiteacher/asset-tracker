# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 저장소에 올라가지 않습니다)
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) > SDK 설정 및 구성 에서 복사
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 보안 규칙 배포용(npm run deploy:rules). 앱 빌드에는 쓰이지 않습니다.
# Firebase 콘솔 > Authentication > 사용자 > 관리자 계정의 "사용자 UID"
FIREBASE_ADMIN_UID=
